# Smart Family Frame — Frame app environment (V2 cloud sync). Copy to `.env.local` and fill in real
# values from the Firebase Console (see FIREBASE_SETUP.md). Every value here is PUBLIC client config
# (safe to ship in the browser bundle) — never put a Firebase service-account key, a Meta access token,
# or any other server secret in this file or in any VITE_* variable.
#
# If this file is absent or any value below is missing, the Frame runs in fully local, offline mode —
# Settings -> Remote Sharing shows "Remote sharing not configured" and every V1 feature keeps working.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" only for local development against `npm run firebase:emulators`.
VITE_FIREBASE_USE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost

# The Family PWA's hosted URL, used to build the QR pairing link shown on the Frame
# (https://<this>/pair?code=XXXXXX). Leave blank during local development.
VITE_FAMILY_APP_URL=
