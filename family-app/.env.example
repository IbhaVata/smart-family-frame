# Smart Family Frame — Family PWA environment. Copy to `.env.local` and fill in the SAME Firebase
# project values as the Frame app's .env.local (see ../.env.example and FIREBASE_SETUP.md). All PUBLIC
# client config — never put a service-account key or any server secret here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" only for local development against `npm run firebase:emulators` (run from the repo root).
VITE_FIREBASE_USE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
