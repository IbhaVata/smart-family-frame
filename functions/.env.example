# Smart Family Frame — Cloud Functions environment (non-secret params). Copy to `.env` (or
# `.env.<project-id>` for a specific deployed project) — see WHATSAPP_SETUP.md.
#
# These values are plain Functions params, not Secret Manager, so a deploy never needs Cloud Billing.
# This file is gitignored per project (only this .example is committed) and these values are never
# shipped to the browser — but they are stored as plain text on disk, not encrypted at rest the way
# Secret Manager secrets are. For local emulator testing, put any placeholder values in `functions/.env`
# (gitignored) — the emulator will not make real Meta API calls regardless.

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
